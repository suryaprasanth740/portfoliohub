rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cover images, avatars: anyone can view (they're embedded in public
    // portfolio pages); only signed-in users can upload, and only into
    // their own folder pattern (enforced client-side today by naming
    // convention — tighten with request.auth.uid path segments as the
    // upload paths are namespaced per user in a later iteration).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
