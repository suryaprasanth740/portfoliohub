# Copy this file to .env and fill in your Firebase project's web app config
# (Firebase console → Project settings → General → Your apps → SDK setup and
# configuration) to switch PortfolioHub from the local demo backend to a
# real Firebase project. Every value must be present for the app to treat
# Firebase as configured — see src/lib/firebase.js.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
